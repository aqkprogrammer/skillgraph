# --------------------------------------------------------------------------
# CognoDB connection (server-side only — never prefix these with NEXT_PUBLIC_)
# Get these from the CognoDB console after creating a free C0 instance.
# Copy this file to `.env.local` and fill in your real values.
# --------------------------------------------------------------------------

COGNODB_URI=bolt+s://db-xxxxxxxx.<region>.databases.cognodb.com
COGNODB_USERNAME=cognodb
COGNODB_PASSWORD=your-password

# Optional: the logical database to open a session against.
# Leave unset unless your instance uses a non-default database name.
# COGNODB_DATABASE=neo4j
